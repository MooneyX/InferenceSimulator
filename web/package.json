{
  "name": "inference-simulator-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "InferenceSimulator 前端（M3 实现）；M2 仅承载 OpenAPI → TS 类型生成",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "gen:openapi": "uv run python -m simserver.openapi_export openapi.json",
    "gen:types": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "gen:api": "npm run gen:openapi && npm run gen:types",
    "check:types": "openapi-typescript openapi.json -o src/api/schema.d.ts --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
