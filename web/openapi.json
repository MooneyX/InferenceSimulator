            "const": "parent_not_completed",
            "title": "Reason",
            "default": "parent_not_completed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "parent_request_id"
        ],
        "title": "SkippedRequest",
        "description": "父轮未成功，因而从未发送的子轮。"
      },
      "SyntheticWorkloadConfig": {
        "properties": {
          "num_requests": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Num Requests",
            "description": "全部轮次请求数"
          },
          "arrival_rate": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Arrival Rate",
            "description": "总请求目标 QPS"
          },
          "prompt_len": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FixedLength"
              },
              {
                "$ref": "#/components/schemas/PoissonLength"
              },
              {
                "$ref": "#/components/schemas/LognormalLength"
              }
            ],
            "title": "Prompt Len",
            "discriminator": {
              "propertyName": "dist",
              "mapping": {
                "fixed": "#/components/schemas/FixedLength",
                "lognormal": "#/components/schemas/LognormalLength",
                "poisson": "#/components/schemas/PoissonLength"
              }
            }
          },
          "output_len": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FixedLength"
              },
              {
                "$ref": "#/components/schemas/PoissonLength"
              },
              {
                "$ref": "#/components/schemas/LognormalLength"
              }
            ],
            "title": "Output Len",
            "discriminator": {
              "propertyName": "dist",
              "mapping": {
                "fixed": "#/components/schemas/FixedLength",
                "lognormal": "#/components/schemas/LognormalLength",
                "poisson": "#/components/schemas/PoissonLength"
              }
            }
          },
          "max_new_tokens": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max New Tokens",
            "description": "每个请求可见的生成上限",
            "default": 128
          },
          "seed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Seed",
            "description": "随机种子；同种子必须逐字节可复现"
          },
          "session": {
            "$ref": "#/components/schemas/SessionConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "num_requests",
          "arrival_rate",
          "prompt_len",
          "output_len",
          "seed"
        ],
        "title": "SyntheticWorkloadConfig",
        "description": "合成负载参数：目标总轮次 QPS、长度分布和 session 拓扑。"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkloadConfig": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "synthetic",
              "trace"
            ],
            "title": "Mode",
            "default": "synthetic"
          },
          "synthetic": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SyntheticWorkloadConfig"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "WorkloadConfig",
        "description": "负载配置。``trace`` 分支仅预留字段，MVP 不实现。"
      }
    }
  }
}
